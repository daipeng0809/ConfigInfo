<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <RootNamespace>ConfigInfo</RootNamespace>
        <AssemblyName>ConfigInfo</AssemblyName>
        <Version>1.2.0</Version>

        <!-- ===== AOT / 裁剪适配 =====
             核心解析/写出不使用反射、动态代码或序列化特性，NativeAOT 下零警告；
             ConfigFile 自动映射是额外的反射便捷层，已单独标注 RequiresUnreferencedCode / RequiresDynamicCode。 -->
        <IsAotCompatible>true</IsAotCompatible>
        <IsTrimmable>true</IsTrimmable>

        <!-- 生成 XML 文档便于调用方获得智能提示 -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>

        <Product>ConfigInfo</Product>
        <Description>面向 AOT 的轻量文本配置库（.cif 格式）：核心零反射、单遍解析、宽松类型转换，支持注释读写、自动注释与可选自动对象映射。</Description>

        <!-- ===== NuGet 包 ===== -->
        <PackageId>ConfigInfo</PackageId>
        <Title>ConfigInfo</Title>
        <Authors>daipeng0809</Authors>
        <Copyright>Copyright (c) 2026 daipeng0809</Copyright>
        <PackageTags>cif;configuration;config;aot;nativeaot;serial;dotnet</PackageTags>
        <PackageProjectUrl>https://github.com/daipeng0809/ConfigInfo</PackageProjectUrl>
        <RepositoryUrl>https://github.com/daipeng0809/ConfigInfo.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
